# SIFT — Frontend Environment Configuration
# =======================================================
# Configures the target FastAPI backend service.
#
# In local development:
#   Backend default: http://127.0.0.1:8000
#
# The API client automatically normalizes trailing slashes
# and routes requests through the '/api' prefix.
#
# For production or containerized setups, update accordingly:
#   NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
# =======================================================
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Note for backend environment variables:
# Backend configuration is managed separately in backend/.env.
# See backend/.env.example for backend settings (LLM provider, ChromaDB, SQLite).
