# SIFT Backend Configuration
PROJECT_NAME="SIFT Document Intelligence API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Storage Configuration
STORAGE_DIR="data/storage"
MAX_UPLOAD_SIZE_MB=10
SQLITE_DB_PATH="data/sift_metadata.db"

# RAG & Chunking Settings
DEFAULT_EMBEDDING_MODEL="all-MiniLM-L6-v2"
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_MINIMUM_CHUNK_SIZE=100
VECTOR_DB_DIR="data/chroma"
CHROMA_COLLECTION_NAME="sift_document_embeddings"

# LLM Generation Provider Configuration (Groq API)
# Get a free-tier API key at: https://console.groq.com/keys
LLM_PROVIDER="groq"
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
CHAT_HISTORY_LIMIT=10
