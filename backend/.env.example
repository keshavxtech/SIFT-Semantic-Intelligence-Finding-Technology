# SIFT Backend Configuration
PROJECT_NAME="SIFT Document Intelligence API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Storage & Database Configuration
STORAGE_DIR="data/storage"
MAX_UPLOAD_SIZE_MB=10

# Database Provider ("sqlite" for local development, "turso" for serverless cloud)
DATABASE_PROVIDER="sqlite"
SQLITE_DB_PATH="data/sift_metadata.db"
# Turso LibSQL Cloud Configuration (Required only when DATABASE_PROVIDER="turso")
TURSO_DATABASE_URL="libsql://your-database-org.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# Vector Store Provider ("chroma" for local development, "pinecone" for serverless cloud)
VECTOR_STORE_PROVIDER="chroma"
VECTOR_DB_DIR="data/chroma"
CHROMA_COLLECTION_NAME="sift_document_embeddings"
# Pinecone Cloud Configuration (Required only when VECTOR_STORE_PROVIDER="pinecone")
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX_NAME="sift-index"
PINECONE_NAMESPACE="sift-embeddings"
PINECONE_HOST="https://sift-index-xxxx.svc.pinecone.io"

# Embedding Provider ("sentence-transformers" for local, "huggingface" for serverless hosted)
EMBEDDING_PROVIDER="sentence-transformers"
DEFAULT_EMBEDDING_MODEL="all-MiniLM-L6-v2"
# Hugging Face Inference API Configuration (Required only when EMBEDDING_PROVIDER="huggingface")
HUGGINGFACE_API_KEY="your_huggingface_api_token_here"
HUGGINGFACE_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
HUGGINGFACE_API_URL="https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2"

# RAG & Chunking Settings
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_MINIMUM_CHUNK_SIZE=100

# LLM Generation Provider Configuration (Groq API)
# Get a free-tier API key at: https://console.groq.com/keys
LLM_PROVIDER="groq"
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
CHAT_HISTORY_LIMIT=10
